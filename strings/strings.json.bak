      "ОК",
      "GUI_CAREER_CANCEL",
      "Отмена",
      "GUI_CAREER_RESUME_EVENT_1",
      "\n\n<b>Возраст:</b> ",
      "GUI_CAREER_RESUME_EVENT_2",
      ", <b>Профессия:</b> ",
