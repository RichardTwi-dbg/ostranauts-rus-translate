[
  {
    "strName": "ENCHeatGalConBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Вас вытаскивают перед трибуналом Галилийской конфедерации, оставляя вашу корабль и снаряжение позади.\n\nНа слушании вы можете попросить штраф — 15 000 долларов, оплачиваемых полностью или в рассрочку — или отправиться в тюрьму в Порте Можаве на год или три лет тяжелой работы.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatGalConFineEnd",
