[
  {
    "strName": "ENCHeatHQCHBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Вы тащат перед хиньхуа-магистратом на суд, оставляя свой корабль и снаряжение позади.\n\nНа заседании вы можете попросить наказание в виде штрафа — 15 000 долларов, оплачиваемых полностью или в рассрочку — или идти в камеру в Qincheng на год или три лет тяжелой работы.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatHQCHFineEnd",
      "ENCHeatHQCHFineDebtEnd",
      "ENCHeatHQCHPrisonStart"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
