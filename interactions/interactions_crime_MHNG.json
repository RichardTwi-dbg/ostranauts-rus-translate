[
  {
    "strName": "ENCHeatMHNGBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Вы тащат перед судьёй из Ханчжоу, оставляя свой корабль и снаряжение позади.\n\nНа заседании вы можете попросить наказание в виде штрафа — 15 000 долларов, оплачиваемых полностью или в рассрочку — или идти в тюрьму на Тарсисе на год или три лет тяжёлой работы.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMHNGFineEnd",
      "ENCHeatMHNGFineDebtEnd",
      "ENCHeatMHNGPrisonStart"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
    "strSubUI": "Landscape01",
