[
  {
    "strName": "ENCHeatMSUZBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Вы доставляются перед судьёй из Сючжоу для суда, оставляя свой корабль и снаряжение позади.\n\nНа заседании вы можете попросить наказание в виде штрафа — 15 000 долларов, оплачиваемых полностью или в рассрочку — или же вас отправляют в тюрьму в Сючжоу на год или три лет тяжёлой работы.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMSUZFineEnd",
      "ENCHeatMSUZFineDebtEnd",
      "ENCHeatMSUZPrisonStart"
    ],
