[
  {
    "strName": "ENCHeatMVOLBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Вы тащат перед судьёй из Xinhua, оставляя свой корабль и снаряжение позади.\n\nНа слушании вы можете попросить наказание в виде штрафа — 15 000 долларов, оплачиваемых полностью или в рассрочку — или идти в тюрьму Вольтера на год или три лет тяжёлой работы.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMVOLFineEnd",
      "ENCHeatMVOLFineDebtEnd",
      "ENCHeatMVOLPrisonStart"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
