[
  {
    "strName": "ENCHeatJATLBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Вы тащат перед атлантийским прокурором на суд, оставляя свой корабль и снаряжение позади.\n\nНа слушании вы можете попросить наказание в виде штрафа — 15 000 долларов, оплачиваемых полностью или в рассрочку — или идти в тюрьму в Атлантиде на год или три лет тяжелой работы.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatJATLFineEnd",
      "ENCHeatJATLFineDebtEnd",
      "ENCHeatJATLPrisonStart"
    ],
