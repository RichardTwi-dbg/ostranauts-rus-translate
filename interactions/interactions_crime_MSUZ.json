  },
  {
    "strName": "ENCHeatMSUZFineEnd",
    "strTitle": "Попросить штраф (в один раз)",
    "strDesc": "Почти как будто они хотят, чтобы вы нарушали правила, чтобы извлечь из вас больше штрафов.\n\nВы подписываете стопы бумаги в тесных цепях.\n\nЭто — другой вид тюремного приговора. Другой груз, висящий на вашей шее.\n\nДобавлен новый штраф в размере 15 000 долларов.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatMSUZFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
    "strSubUI": "Landscape01",
