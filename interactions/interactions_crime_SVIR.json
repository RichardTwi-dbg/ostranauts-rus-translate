[
  {
    "strName": "ENCHeatSVIRBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Они тащат вас перед судьёй-милитаристом титана для суда, оставляя вашу станцию и снаряжение позади.\n\nНа заседании вы можете попросить наказание в виде штрафа — 15 000 долларов, оплачиваемых полностью или в рассрочку — или идти в тюрьму в Вирджинии на год или три лет тяжёлой работы.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatSVIRFineEnd",
      "ENCHeatSVIRFineDebtEnd",
      "ENCHeatSVIRPrisonStart"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
