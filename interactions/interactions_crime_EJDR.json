[
  {
    "strName": "ENCHeatEJDRBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Вы вынуждены пройти суд перед китайским судьей, оставляя свой корабль и снаряжение за собой.\n\nНа заседании вы можете попросить наказание в виде штрафа — 15 000 долларов, оплачиваемых полностью или в рассрочку — или же вас отправят в тюрьму «Жёлтый Заяц» на год или три, в зависимости от обстоятельств.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatEJDRFineEnd",
      "ENCHeatEJDRFineDebtEnd",
      "ENCHeatEJDRPrisonStart"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
    "strRaiseUI": "SocialCombat",
    "strSubUI": "Landscape01",
