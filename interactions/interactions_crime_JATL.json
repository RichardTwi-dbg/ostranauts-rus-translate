  },
  {
    "strName": "ENCHeatJATLFineDebtEnd",
    "strTitle": "Попросить штраф (в рассрочку)",
    "strDesc": "Почти как будто они хотят, чтобы вы нарушали правила, чтобы вынудить вас платить больше процентов.\n\nВы подписываете стопы бумаги в тесных цепях.\n\nЭто — другой вид тюремного приговора. Другой груз, висящий на вашей шее.\n\nДобавлен новый долг в размере 15 000 долларов, платежи требуются каждый смена.",
    "strColor": "Dialogue",
    "aInverse": [
      "ENCHeatJATLFineFinish"
    ],
    "fDuration": 0.0,
    "strThemType": "Self",
