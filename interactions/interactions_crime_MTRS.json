[
  {
    "strName": "ENCHeatMTRSBustedStart",
    "strTitle": "Разоблачены",
    "strDesc": "Они приводят тебя перед магистратом Синьхуа для вынесения приговора, оставляя твой корабль и снаряжение позади.\n\nНа слушании ты можешь попросить только штраф — 15 000 долларов, оплачиваемый единовременно или частями — иначе тебя отправят в тюрьму Tharsis Landing Brig на год или три года тяжелого труда.",
    "strColor": "Dialogue",
    "aInverse": [
